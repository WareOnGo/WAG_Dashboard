VITE_API_BASE_URL=http://localhost:3001/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback
# PPT generation is served by the API above — no separate host. Set this only
# to point a dev build at a different PPT backend; unset, it uses the API.
# VITE_PPT_API_BASE_URL=
